# 硅基流动 API Key（从 https://cloud.siliconflow.cn 获取）
OPENAI_API_KEY=sk-...

# 硅基流动接口地址（兼容 OpenAI 格式，换成 https://api.openai.com/v1 可直接用 OpenAI）
OPENAI_BASE_URL=https://api.siliconflow.cn/v1

# 对话 & 蒸馏模型（硅基流动可用：deepseek-ai/DeepSeek-V3、Qwen/Qwen2.5-72B-Instruct 等）
CHAT_MODEL=deepseek-ai/DeepSeek-V3
DISTILL_MODEL=deepseek-ai/DeepSeek-V3

# 向量嵌入模型（硅基流动可用：BAAI/bge-m3、BAAI/bge-large-zh-v1.5 等）
EMBEDDING_MODEL=BAAI/bge-m3

DATA_DIR=./data
MAX_CONTEXT_TURNS=20
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]
